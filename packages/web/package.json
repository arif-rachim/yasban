{
  "name": "@yasban/web",
  "version": "0.1.0",
  "description": "Yasban Web App - Visual MCP Server Builder",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/cleanup-dev.js --ports 3001 --electron --next && concurrently \"npm run dev:next\" \"npm run dev:electron:wait\" --kill-others",
    "dev:next": "next dev -p 3001",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev:electron:wait": "wait-on http://localhost:3001 && npm run dev:electron",
    "dev:debug": "cross-env NODE_ENV=development electron . --inspect=5858",
    "build": "npm run build:next && npm run build:electron",
    "build:next": "next build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "rimraf out dist .next node_modules/.cache"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@monaco-editor/react": "^4.6.0",
    "@prisma/client": "^6.1.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@tanstack/react-table": "^8.21.3",
    "@yasban/shared": "*",
    "autoprefixer": "^10.4.20",
    "chokidar": "^4.0.3",
    "electron-is-dev": "^3.0.1",
    "electron-serve": "^2.1.0",
    "electron-store": "^10.0.0",
    "express": "^4.21.2",
    "jotai": "^2.10.3",
    "monaco-editor": "^0.52.2",
    "next": "^15.0.3",
    "node-machine-id": "^1.1.12",
    "node-windows": "^1.0.0-beta.8",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "tailwindcss": "^3.4.15",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "optionalDependencies": {
    "node-linux": "^0.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "electron-updater": "^6.3.9",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.0.3",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "wait-on": "^9.0.1"
  }
}
